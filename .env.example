# Developer 2 (Backend / AI) — env keys only. Never put a real key in this file.
# Copy to .env and fill in. Keys are read from the environment only.

# --- primary provider -------------------------------------------------------
# One of: gemini | groq | cerebras | nvidia | openrouter | openai_compatible
AI_PROVIDER=
# Model id exactly as the provider lists it. Verified in the benchmark, not assumed.
AI_MODEL=
# Key for the selected provider. Per-provider overrides also work:
#   AI_GEMINI_API_KEY / AI_GROQ_API_KEY / AI_CEREBRAS_API_KEY /
#   AI_NVIDIA_API_KEY / AI_OPENROUTER_API_KEY
AI_API_KEY=
# Optional. Overrides the built-in default host for the chosen provider.
# Required for openai_compatible.
AI_BASE_URL=
# Optional. Model override for that provider, e.g. AI_GROQ_MODEL.
AI_GEMINI_MODEL=
AI_GROQ_MODEL=
AI_CEREBRAS_MODEL=
AI_NVIDIA_MODEL=
AI_OPENROUTER_MODEL=

# --- fallback provider (optional) -------------------------------------------
# Used when the primary times out, is rate limited, or 5xxs. Leave blank to run
# single-provider with typed errors only.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=

# --- reliability ------------------------------------------------------------
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
# Set to false if a provider claims no JSON mode; defaults to true.
AI_SUPPORTS_JSON_MODE=true

# --- context bounds (enforced in code and covered by tests) -----------------
AI_CONTEXT_EVIDENCE_CAP=12
AI_CONTEXT_EVENT_CAP=15
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=900
# When false, an unavailable provider raises a typed error instead of a
# clearly-labelled deterministic answer.
AI_ALLOW_DETERMINISTIC_FALLBACK=true